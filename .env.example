# Copy to .env and fill in. .env is git-ignored.

# Base URL of the self-hosted UniFi OS Server (self-signed certificate is expected)
UNIFI_BASE_URL=https://localhost:11443

# Owner account created in Task #1 (UI account with MFA enabled)
UNIFI_ADMIN_USERNAME=you@example.com
UNIFI_ADMIN_PASSWORD=change-me

# MFA: base32 secret of the authenticator (TOTP) app registered on the UI account.
# You get it when enabling "Authenticator app" MFA on account.ui.com ("can't scan the QR code?").
# The tests generate the 6-digit code from it, so they run unattended.
UNIFI_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Optional: password used for the generated local users (a strong random one is used if empty)
UNIFI_LOCAL_USER_PASSWORD=

# Optional: verify TLS (false for the default self-signed certificate)
UNIFI_VERIFY_TLS=false

# Optional: record the UI's API calls to reports/network.har (contains credentials, keep it local)
UNIFI_RECORD_HAR=
